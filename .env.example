# ==============================================================================
# Punto de Vista (puntodevista.click) - Variables de Entorno (.env)
# ==============================================================================

# --- Motor LLM OpenAI-Compatible (Local llama.cpp / OpenRouter / Groq / DeepSeek) ---
# Por defecto apunta al motor local soberano en el VPS (Qwen 2.5 7B en llama-server)
OPENAI_BASE_URL=http://127.0.0.1:8090/v1
OPENAI_API_KEY=local-no-key
MODEL_NAME=qwen2.5-7b-instruct

# Si prefieres usar proveedores externos compatibles con OpenAI, basta con descomentar:
# OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-xxxxxxxx
# MODEL_NAME=deepseek/deepseek-chat

# Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_xxxxxxxx
# MODEL_NAME=llama-3.3-70b-versatile

# DeepSeek:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-xxxxxxxx
# MODEL_NAME=deepseek-chat

# --- Telegram Bot & Canal ---
# TG_TOKEN=123456789:ABCDEF...
# TG_CHAT_ID=-100123456789

# --- Email Newsletters (Ingesta de correo) ---
# EMAIL_ADDRESS=usuario@gmail.com
# EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
